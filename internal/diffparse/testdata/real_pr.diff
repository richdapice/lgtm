+interface SpecCounts {
+  compliant: number
+  /** How many of the compliant customers are business-type (PS 1583 §3). */
+  business: number
+  expiring: number
+  expired: number
+  crdPending: number
+  oneId: number
+  drafts: number
+  termFresh: number
+  termAging: number
+  termReassigned: number
+  /** 'established' spreads onboarding across ~12 months; 'new' keeps it recent. */
+  spread: 'established' | 'new'
+}
+
+/**
+ * Build a store's customer spread from per-bucket counts. Onboarding months
+ * are distributed across the store's age so each store's growth curve and
+ * compliance mix differ — no two stores look alike.
+ */
+function buildSpecs(c: SpecCounts): Spec[] {
+  const maxMonth = c.spread === 'new' ? 7 : 12
+  // Distribute n items across [lo, maxMonth] months-ago.
+  const monthAt = (i: number, n: number, lo = 1): number =>
+    n <= 1 ? Math.round((lo + maxMonth) / 2) : lo + Math.round((i / (n - 1)) * (maxMonth - lo))
+
+  const specs: Spec[] = []
+  for (let i = 0; i < c.compliant; i++) {
+    specs.push({
+      bucket: 'compliant',
+      monthsAgo: monthAt(i, c.compliant),
+      serviceType: i < c.business ? 'business' : 'residential'
+    })
+  }
+  for (let i = 0; i < c.expiring; i++)
+    specs.push({ bucket: 'expiring', monthsAgo: monthAt(i, c.expiring, 2), serviceType: 'residential' })
+  for (let i = 0; i < c.expired; i++)
+    specs.push({ bucket: 'expired', monthsAgo: monthAt(i, c.expired, 4), serviceType: 'residential' })
+  for (let i = 0; i < c.crdPending; i++)
+    specs.push({ bucket: 'crd_pending', monthsAgo: monthAt(i, c.crdPending, 1), serviceType: 'residential' })
+  for (let i = 0; i < c.oneId; i++)
+    specs.push({ bucket: 'one_id', monthsAgo: monthAt(i, c.oneId, 3), serviceType: 'residential' })
+  for (let i = 0; i < c.drafts; i++)
+    specs.push({ bucket: 'draft', monthsAgo: i, serviceType: i % 2 ? 'business' : 'residential' })
+  for (let i = 0; i < c.termFresh; i++)
+    specs.push({ bucket: 'term_fresh', monthsAgo: 8 + i, serviceType: 'residential' })
+  for (let i = 0; i < c.termAging; i++)
+    specs.push({ bucket: 'term_aging', monthsAgo: 10 + i, serviceType: 'residential' })
+  for (let i = 0; i < c.termReassigned; i++)
+    specs.push({ bucket: 'term_reassigned', monthsAgo: 9 + i, serviceType: 'residential' })
+  return specs
 }
 
